# Hosted Arc testnet API. Copy values into the Vercel API project's testnet environment;
# do not commit the completed file.
PORT=8787
HOST=0.0.0.0
NODE_ENV=production
EVABOB_ENV=testnet
ENABLE_PRODUCTION_LAUNCH=false
DATA_DIR=/tmp/evabob
APP_NAME=evabob

ALLOW_HEADER_AUTH=false
CORS_ORIGINS=https://testnet.evabob.app
API_PUBLIC_URL=https://api-testnet.evabob.app
APP_PUBLIC_URL=https://testnet.evabob.app
OPERATOR_USER_IDS=
CRON_SECRET=

# Server-controlled app capabilities. Enable only after the corresponding
# route passes the acceptance run in this exact hosted environment.
FEATURE_DIRECT_SEND=true
FEATURE_PROTECTED_SEND=true
FEATURE_REQUESTS=true
FEATURE_GATEWAY=false
FEATURE_CONVERSION=false
FEATURE_BRIDGE_ROUTES=
FEATURE_AGENT_WALLETS=false
FEATURE_X402_EXECUTION=false
FEATURE_AGENT_BATCH_SEND=false

MONGODB_URI=
MONGODB_DB=evabob_testnet

DYNAMIC_ENVIRONMENT_ID=
DYNAMIC_API_TOKEN=
CIRCLE_WALLETS_APP_ID=
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
GATEWAY_API_BASE=https://gateway-api-testnet.circle.com/v1
ADMIN_SAFE_ADDRESS=0xe2Ef46038d30F80B39DA2E775F637BE2fa2635A2
IDENTITY_REGISTRY=0xb14355288fcE19811cccaF1589ea85e3791320a0
PAYMENT_ESCROW=0xd6b5cbCD102C848EB402bCB31E8FbB8f0b2b6805

# Three distinct hosted hot keys. Never use a Safe owner key here.
PRIVATE_KEY=
IDENTITY_LINKER_PRIVATE_KEY=
ESCROW_ATTESTOR_PRIVATE_KEY=

USE_APP_KIT=true
APP_KIT_ADAPTER=circle-wallets
KIT_KEY=
APP_KIT_DC_WALLET=
APP_KIT_FEE_RECIPIENT=
APP_KIT_FEE_BPS=0
APP_KIT_KEEP_LEGACY=true

AGENT_MAX_DAILY_LIMIT_USDC=100
AGENT_MAX_USER_DAILY_SPEND_USDC=250
AGENT_RESOURCE_ORIGINS=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
EXCHANGE_RATE_API_KEY=

PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=mt1
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Evabob <noreply@evabob.app>
SMTP_SECURE=true
