PORT=8787
HOST=0.0.0.0
NODE_ENV=development
EVABOB_ENV=local
# Intentionally false until all mainnet addresses and Circle credentials exist.
ENABLE_PRODUCTION_LAUNCH=false
DATA_DIR=./data
APP_NAME=evabob

# ─── Auth ────────────────────────────────────────────────────────────────────
# Every /v1 route identifies the caller from a Dynamic JWT verified against
# Dynamic's JWKS. Public routes: /v1/health, /v1/config/public, /v1/fx/rates.
#
# ALLOW_HEADER_AUTH re-enables the legacy `x-user-id` header as an identity
# claim. That header is attacker-controlled: with it on, ANY caller can act as
# ANY user (read balances and chats, release escrow, spend agent funds).
# Local development and demo builds ONLY. Leave unset in every other case.
ALLOW_HEADER_AUTH=false
# Dynamic user ids allowed to call treasury/test/maintenance routes. Empty
# means those routes deny everyone.
OPERATOR_USER_IDS=

# Browser origins allowed to call the API, comma-separated. Native mobile
# clients are unaffected by CORS. Use an explicit list outside development.
# CORS_ORIGINS=https://evabob.app,http://localhost:3000
CORS_ORIGINS=*
# Origin of the browser build of the app (web-app/), added to CORS_ORIGINS.
# WEB_APP_ORIGIN=https://app.evabob.app
# Canonical externally reachable API origin. Hosted environments require HTTPS.
API_PUBLIC_URL=

# Dynamic Labs — app login (email OTP). API token is server-only.
DYNAMIC_ENVIRONMENT_ID=
DYNAMIC_API_TOKEN=

# Circle User-Controlled Wallets (ops / PIN / send / Gateway)
CIRCLE_WALLETS_APP_ID=
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# ─── Agent spend wallets ─────────────────────────────────────────────────────
# Agent balances are credited only from a verified on-chain USDC transfer to
# the agent's custody address, so the ledger cannot exceed what arrived.
# These bound the secondary rails: the per-agent daily limit is chosen by the
# user at creation (clamped to the first value), and the second caps total
# daily x402 spend across every agent one user owns.
AGENT_MAX_DAILY_LIMIT_USDC=100
AGENT_MAX_USER_DAILY_SPEND_USDC=250
# Exact comma-separated HTTPS origins the agent may contact. Empty is safest
# and leaves x402 resource execution unavailable.
AGENT_RESOURCE_ORIGINS=

# Arc
# Ops signer: gas + working-capital USDC. Should hold NO contract admin role.
# IDENTITY_LINKER_PRIVATE_KEY signs verified links and same-owner unlinks. It
# cannot rotate itself or change the registry admin. ADMIN_SAFE_ADDRESS is the
# expected 2-of-3 Safe that controls registry and escrow role rotation.
IDENTITY_LINKER_PRIVATE_KEY=
ESCROW_ATTESTOR_PRIVATE_KEY=
ADMIN_SAFE_ADDRESS=
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
PRIVATE_KEY=
IDENTITY_REGISTRY=
# The registry PaymentEscrowV3 resolves claims against, when it differs from
# IDENTITY_REGISTRY (V2 while the registry is V3). People are linked in both.
ESCROW_IDENTITY_REGISTRY=
PAYMENT_ESCROW=

# Mongo is authoritative for the atomic application snapshot and coordinates
# its single writer. Local JSON files are a development fallback and mirror.
# Production requires Mongo and fails closed when it is unavailable.
MONGODB_URI=
MONGODB_DB=evabob

# Destination RPCs for CCTP mint (optional). Public sepolia.base.org often
# 503s eth_gasPrice; mint falls back to PublicNode / dRPC automatically.
# BASE_SEPOLIA_RPC_URL=https://base-sepolia-rpc.publicnode.com
# ETH_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

GATEWAY_API_BASE=https://gateway-api-testnet.circle.com/v1

PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=mt1

# Mailtrap (or any SMTP) — claim / receive emails
# https://mailtrap.io/ → Email Testing → SMTP settings
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Evabob <noreply@evabob.app>
SMTP_SECURE=false

# Used inside claim-link emails
APP_PUBLIC_URL=https://evabob.app
