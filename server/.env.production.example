# Production remains locked until Arc mainnet contracts, Circle production
# credentials, domains and operating controls are reviewed and configured.
PORT=8787
HOST=0.0.0.0
NODE_ENV=production
EVABOB_ENV=production
ENABLE_PRODUCTION_LAUNCH=false
DATA_DIR=/data
APP_NAME=evabob

ALLOW_HEADER_AUTH=false
CORS_ORIGINS=https://evabob.app
API_PUBLIC_URL=https://api.evabob.app
APP_PUBLIC_URL=https://evabob.app
OPERATOR_USER_IDS=

MONGODB_URI=
MONGODB_DB=evabob

DYNAMIC_ENVIRONMENT_ID=
DYNAMIC_API_TOKEN=
CIRCLE_WALLETS_APP_ID=
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# No testnet defaults are allowed here. Configure reviewed mainnet values.
ARC_RPC_URL=
ARC_CHAIN_ID=
GATEWAY_API_BASE=
ADMIN_SAFE_ADDRESS=
IDENTITY_REGISTRY=
PAYMENT_ESCROW=
PRIVATE_KEY=
IDENTITY_LINKER_PRIVATE_KEY=
ESCROW_ATTESTOR_PRIVATE_KEY=

USE_APP_KIT=true
APP_KIT_ADAPTER=circle-wallets
KIT_KEY=
APP_KIT_DC_WALLET=
APP_KIT_KEEP_LEGACY=false
PLATFORM_FEE_ADDRESS=
PLATFORM_FEE_BPS=5
AGENT_RESOURCE_ORIGINS=
GROQ_API_KEY=
EXCHANGE_RATE_API_KEY=
