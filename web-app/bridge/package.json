{
  "name": "evabob-web-bridge",
  "private": true,
  "description": "Browser-side bridges for the Evabob web-app (Dynamic sign-in).",
  "type": "module",
  "scripts": {
    "build": "esbuild src/dynamic_bridge.js --bundle --format=iife --platform=browser --target=es2020 --minify --legal-comments=none --define:process.env.NODE_ENV=\\\"production\\\" --define:global=globalThis --outfile=../web/js/dynamic_bridge.js"
  },
  "dependencies": {
    "@dynamic-labs-sdk/client": "1.34.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
